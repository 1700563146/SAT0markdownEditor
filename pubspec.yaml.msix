# 沢 Markdown 编辑器 - MSIX 打包配置
# 版本: 1.5.9

msix_config:
  display_name: 沢
  publisher_display_name: 沢 Markdown Editor
  identity_name: Taku.Markdown.Editor
  msix_version: 1.5.9.0
  logo_path: app.png
  trim_logo: true
  capabilities: internetClient, documentsLibrary, picturesLibrary
  languages: zh-cn, en-us
  install_certificate: false
  output_name: 沢-1.5.9
  output_path: build\msix
